# Meta Model API (https://api.meta.ai/v1) — required for the tribunal
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Fast agents (prosecutor, defense, clerk) and the judge can use different models
MUSE_MODEL=muse-spark-1.3
MUSE_JUDGE_MODEL=muse-spark-1.3

# PostgreSQL. When unset or unreachable the backend falls back to embedded PGlite in ./.data
DATABASE_URL=postgres://xscan:xscan@localhost:5432/xscan

# SAM.gov Contract Opportunities API key (https://open.gsa.gov/api/get-opportunities-public-api/)
SAM_API_KEY=

# Chrome or Chromium for reading tender pages that need JavaScript. Found automatically in the usual places;
# set it when it is installed somewhere else.
CHROME_PATH=

PORT=4000
CORS_ORIGIN=http://localhost:3000
