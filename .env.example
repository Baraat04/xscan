# Copy to .env next to docker-compose.prod.yml on the server
DB_PASSWORD=
# Addresses Caddy serves: the domain gets https, http://<ip> stays plain http
SITE_ADDRESSES=example.com, http://203.0.113.10
# The same addresses as browser origins, for the backend's origin check
SITE_ORIGINS=https://example.com,http://203.0.113.10
